# Copy to .env and fill in. .env is gitignored — never commit real secrets.
#
# Cloudflare Tunnel is NOT configured here — this box already runs cloudflared
# as a host systemd service (/etc/cloudflared/config.yml) serving other
# subdomains. deploy.sh adds egolab.top's ingress rules to that same file and
# reloads the service; no token is needed by docker compose.

# --- Fase 3: per-project web app secrets (added incrementally as each project
#     is onboarded — see content/registry.json and labs/<slug>/) ---

# if3110-tubes (wbd.egolab.top) — its own dedicated DB user/database on the
# shared homelab `postgres` container (/opt/app/homelab), not a new instance.
IF3110_POSTGRES_PASSWORD=change-me

# if3310-tubes (linkedin.egolab.top) — same shared-postgres pattern, plus its
# own JWT signing secret and a VAPID keypair for web push notifications
# (generate with: npx web-push generate-vapid-keys).
IF3310_POSTGRES_PASSWORD=change-me
IF3310_JWT_SECRET=change-me
IF3310_VAPID_PUBLIC_KEY=change-me
IF3310_VAPID_PRIVATE_KEY=change-me

# riilcert (riilcert.egolab.top) — no backend/DB, no Traefik. Talks to the
# already-deployed Sepolia contract straight from the browser via ethers.js;
# this is just the RPC endpoint used for that (default: free public
# endpoint, no API key). Get your own key (Alchemy/Infura) and override this
# if the public one gets rate-limited.
RIILCERT_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# tubes1-kripto / SigmaChat (sigmachat.egolab.top) — same shared-postgres
# pattern as if3110/if3310, plus its own JWT signing secret. No Traefik —
# reverse-proxied by labs/tubes1-kripto's own nginx like every other project
# here.
SIGMACHAT_POSTGRES_PASSWORD=change-me
SIGMACHAT_JWT_SECRET=change-me
